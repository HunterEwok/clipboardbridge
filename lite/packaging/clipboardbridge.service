# The lite member's unit. The release archive carries it as
# packaging/linux/clipboardbridge.service, in place of the full member's, for
# the same install.sh (lite/packaging/archive.sh).

[Unit]
Description=Clipboard Bridge lite member
Documentation=https://github.com/HunterEwok/clipboardbridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# install.sh --port N writes CBB_PORT here.
EnvironmentFile=-/etc/clipboardbridge/clipboardbridge.env
ExecStart=/usr/local/bin/cbb run
User=clipboardbridge
Group=clipboardbridge
StateDirectory=clipboardbridge
StateDirectoryMode=0700
RuntimeDirectory=clipboardbridge
RuntimeDirectoryMode=0750
UMask=0007
Restart=on-failure
RestartSec=2s

# The lite member needs no privileges: it dials the computers, listens on
# the member port (8764, above 1024) for phones, Macs and other lite members,
# and publishes and browses mDNS on UDP 5353, which it shares with
# avahi-daemon or resolved.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
# Secrets live only in memory; none of it goes to swap (where the kernel has no
# memory controller, systemd leaves this out).
MemorySwapMax=0

# No IPAddressDeny/IPAddressAllow: the BPF maps they need fail on small
# boards such as the Pi Zero, and the member port itself takes only home
# network addresses.

[Install]
WantedBy=multi-user.target
