      }
    },
    "Done arranging": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закончить расстановку"
          }
        }
      }
    },
    "Drag devices here": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите сюда устройства"
          }
        }
      }
    },
    "Drag devices here, or add them with Move to collection in a device's menu.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите сюда устройства или добавьте их пунктом «В коллекцию» в меню устройства."
          }
        }
      }
    },
    "Drag to arrange. Drop a device on a collection to put it in. Option and the arrow keys move the focused tile.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетаскивайте плитки, чтобы расставить их. Бросьте устройство на коллекцию, чтобы положить его туда. Option и стрелки двигают плитку в фокусе."
          }
        }
      }
    },
    "Menu": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меню"
          }
        }
      }
    },
    "Move earlier": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переместить раньше"
          }
        }
      }
    },
    "Move later": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переместить позже"
          }
        }
      }
    },
    "Move to collection": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В коллекцию"
          }
        }
      }
    },
    "Move to end": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В конец"
          }
        }
      }
    },
    "Move to start": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В начало"
          }
        }
      }
    },
    "Needs attention": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Требует внимания"
          }
        }
      }
    },
    "New collection": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новая коллекция"
          }
        }
      }
    },
    "New collection…": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новая коллекция…"
          }
        }
      }
    },
    "No devices match.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подходящих устройств нет."
          }
        }
      }
    },
    "Online": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В сети"
          }
        }
      }
    },
    "Rename collection": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переименовать коллекцию"
          }
        }
      }
    },
    "Rename collection…": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переименовать коллекцию…"
          }
        }
      }
    },
    "Save": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранить"
          }
        }
      }
    },
    "Search devices": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поиск устройств"
          }
        }
      }
    },
    "Take out of collection": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Убрать из коллекции"
          }
        }
      }
    },
    "The tiles stay as they were: that change does not fit.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Плитки остались как были: такое изменение не подходит."
          }
        }
      }
    },
    "Ungroup": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разгруппировать"
          }
        }
      }
    },
    "collection, %lld of %lld online": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "коллекция, %1$lld из %2$lld в сети"
          }
        }
      }
    },
    "collection, %lld of %lld online, needs attention": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "коллекция, %1$lld из %2$lld в сети, требует внимания"
          }
        }
      }
    },
    "Join a phone's group": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войти в группу телефона"
          }
        }
      }
    },
    "Show a QR code here and scan it with the phone app, or make a group of computers with cbb new.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Покажите здесь QR-код и отсканируйте его приложением на телефоне или создайте группу компьютеров командой cbb new."
          }
        }
      }
    },
    "Allow cbb to run as the administrator; the QR code shows next.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите cbb работать от имени администратора, и следом появится QR-код."
          }
        }
      }
    },
    "In the CBB app on the phone, tap \"Connect a new device\" and scan this code:": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В приложении CBB на телефоне нажмите «Подключить новое устройство» и отсканируйте этот код:"
          }
        }
      }
    },
    "Without a camera, paste this into the app:": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без камеры вставьте в приложение этот текст:"
          }
        }
      }
    },
    "The code is valid for %lld more min.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Код действует ещё %lld мин."
          }
        }
      }
    },
    "If the phone cannot connect, the firewall must let it reach TCP port %lld here.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если телефон не может подключиться, брандмауэр должен пропускать его к TCP-порту %lld на этом Mac."
          }
        }
      }
    },
    "Joined the group.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac вошёл в группу."
          }
        }
      }
    },
    "QR code": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "QR-код"
          }
        }
      }
    },
    "The app could not make the file for the QR code.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение не смогло создать файл для QR-кода."
          }
        }
      }
    },
    "This Mac was removed from the group": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот Mac удалён из группы"
          }
        }
      }
    },
    "Make it a hub": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сделать хабом"
          }
        }
      }
    },
    "Make %@ a hub?": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сделать %@ хабом?"
          }
        }
      }
    },
    "It is a hub now that only passes the copies on, and reads none of them.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Теперь это хаб, который только пересылает копии и ни одной не читает."
          }
        }
      }
    },
    "It is a hub now.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Теперь это хаб."
          }
        }
      }
    },
    "Your devices then reach the group through it when they are away from home, through the project's forwarder at cbb.tools.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вне дома ваши устройства будут связываться с группой через него, через пересыльщик проекта на cbb.tools."
          }
        }
      }
    },
    "Your devices then reach the group through it when they are away from home, through the project's forwarder at cbb.tools. Sync away from home must be on there already; only its own user turns it on.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вне дома ваши устройства будут связываться с группой через него, через пересыльщик проекта на cbb.tools. Синхронизация вне дома должна быть уже включена на нём: включает её только его пользователь."
          }
        }
      }
    },
    "A hub needs sync away from home, which is off on this Mac, so this turns it on first. Your devices then reach the group through this Mac when they are away from home, through the project's forwarder at cbb.tools.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хабу нужна синхронизация вне дома, а на этом Mac она выключена, поэтому сначала она включится. Вне дома ваши устройства будут связываться с группой через этот Mac, через форвардер проекта на cbb.tools."
          }
        }
      }
    },
    "Stop %@ being the hub?": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ перестанет быть хабом?"
          }
        }
      }
    },
    "Stop being the hub": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перестать быть хабом"
          }
        }
      }
    },
    "Your devices away from home then go through the group's next hub.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вне дома ваши устройства пойдут через следующий хаб группы."
          }
        }
      }
    },
    "The group has no other hub: your devices away from home stop syncing until a device is a hub again. To keep them syncing, make another computer a hub first.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Другого хаба в группе нет: вне дома ваши устройства перестанут синхронизироваться, пока какое-нибудь устройство снова не станет хабом. Чтобы они не теряли связь, сначала сделайте хабом другой компьютер."
          }
        }
      }
    },
    "This is the group's hub": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это хаб группы"
          }
        }
      }
    },
    "A phone is a hub only from its own app's Settings, while the app is open.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Телефон становится хабом только в настройках своего приложения и только пока приложение открыто."
          }
        }
      }
    },
    "A lite member is never a hub.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лёгкий участник не бывает хабом."
          }
        }
      }
    },
    "A watch is never a hub.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Часы не бывают хабом."
          }
        }
      }
    },
    "It runs without administrator rights, so it is never a hub.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он работает без прав администратора, поэтому не бывает хабом."
          }
        }
      }
    },
    "It is frozen: the root unfreezes it first.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он заморожен: сначала корень должен его разморозить."
          }
        }
      }
    },
    "Only the group's root or an admin is a hub: the root makes this Mac an admin first.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хабом бывает только корень группы или админ: сначала корень должен сделать этот Mac админом."
          }
        }
      }
    },
    "Only the group's root or an admin is a hub: make it an admin first.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хабом бывает только корень группы или админ: сначала сделайте его админом."
          }
        }
      }
    },
    "Only an admin makes another device a hub.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сделать хабом другое устройство может только админ."
          }
        }
      }
    },
    "It is no hub any more.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Больше не хаб."
          }
        }
      }
    },
    "Admit by QR code": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Принять по QR-коду"
          }
        }
      }
    },
    "A phone with Aurora OS or Sailfish OS shows a QR code and waits. Paste the code's text, or open a picture of it:": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Телефон с ОС Аврора или Sailfish OS показывает QR-код и ждёт. Вставьте текст кода или откройте его снимок:"
          }
        }
      }
    },
    "The QR code's text": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст QR-кода"
          }
        }
      }
    },
    "Open a picture": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открыть снимок"
          }
        }
      }
    },
    "Admit": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Принять"
          }
        }
      }
    },
    "It joined the group.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устройство вошло в группу."
          }
        }
      }
    },
    "This QR code is not of a device that waits to join.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это QR-код не устройства, которое ждёт входа в группу."
          }
        }
      }
    },
    "No QR code was found in the picture.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На снимке не найден QR-код."
          }
        }
      }
    },
    "The app could not make the file for cbb.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложению не удалось создать файл для cbb."
          }
        }
      }
    },
    "Admit it as an admin: it may then add, remove and renew devices and take the group over after the takeover delay. Only for your own phone.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Принять как админа: он сможет добавлять, удалять и продлевать устройства и после задержки забрать группу себе. Только для своего телефона."
          }
        }
      }
    },
    "On": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вкл"
          }
        }
      }
    },
    "Off": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выкл"
          }
        }
      }
    },
    "Sync": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронизация"
          }
        }
      }
    },
    "Sync is set.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронизация изменена."
          }
        }
      }
    },
    "Sync on": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронизация вкл"
          }
        }
      }
    },
    "Sync off": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронизация выкл"
          }
        }
      }
    },
    "Sync off until %@": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронизация выкл до %@"
          }
        }
      }
    },
    "Click to turn sync off or on; open the menu for a time": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите, чтобы выключить или включить синхронизацию; в меню можно выбрать время"
          }
        }
      }
    },
    "Sync is on here: copies go to the group and come from it.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронизация включена: копии уходят в группу и приходят из неё."
          }
        }
      }
    },
    "Sync is off here: the clipboard is this Mac's own.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронизация выключена: буфер обмена только этого Mac."
          }
        }
      }
    },
    "Off, the clipboard is this Mac's own; Fetch still brings the group's text.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда выключено, буфер обмена только этого Mac; «Получить» всё равно приносит текст группы."
          }
        }
      }
    }
  },
  "version": "1.0"
}
