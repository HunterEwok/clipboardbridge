{
  "sourceLanguage": "en",
  "strings": {
    "%lld of %lld online": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В сети: %1$lld из %2$lld"
          }
        }
      }
    },
    "A phone joins from the start screen of its app.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Телефон присоединяется с начального экрана своего приложения."
