        }
      }
    },
    "Lite member": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лёгкий участник"
          }
        }
      }
    },
    "Lite member, rootless": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лёгкий участник, rootless"
          }
        }
      }
    },
    "Lost a phone? Make a second phone an admin: on it, tap I already use CBB on another phone, then scan its code here with +.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Потеряли телефон? Сделайте второй телефон админом: на нём нажмите «У меня уже есть CBB на другом телефоне» и отсканируйте его код здесь через +."
          }
        }
      }
    },
    "MAC address": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "MAC-адрес"
          }
        }
      }
    },
    "Make %@ an admin?": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сделать %@ админом?"
          }
        }
      }
    },
    "Make a computer an admin": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сделать компьютер админом"
          }
        }
      }
    },
    "Make it an admin": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сделать админом"
          }
        }
      }
    },
    "Menu": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
