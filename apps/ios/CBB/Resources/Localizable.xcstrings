    "Recovery key": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ восстановления"
          }
        }
      }
    },
    "A sheet to print and keep away from your phones. If every phone with this group is lost, a computer of the group or a new phone takes the group back with it, after the group's wait.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лист, который печатают и хранят отдельно от телефонов. Если потеряны все телефоны этой группы, с ним компьютер группы или новый телефон вернёт группу после времени ожидания группы."
          }
        }
      }
    },
    "Make a new recovery key?": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сделать новый ключ восстановления?"
          }
        }
      }
    },
    "Make a new one": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сделать новый"
          }
        }
      }
    },
    "The sheet printed for the old key stops working.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лист, напечатанный для старого ключа, перестанет действовать."
