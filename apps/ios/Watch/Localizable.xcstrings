{
  "sourceLanguage": "en",
  "strings": {
    "%lld of %lld online": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld из %lld в сети"
          }
        }
      }
    },
    "As the iPhone last said.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По последним данным с iPhone."
          }
        }
      }
    },
    "At home: syncing directly.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дома: синхронизация напрямую."
          }
        }
      }
    },
    "Away from home": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вне дома"
          }
        }
      }
    },
    "Connecting to the hub…": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключение к хабу…"
          }
        }
      }
    },
    "Devices": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устройства"
          }
        }
      }
    },
    "Done." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Готово."
          }
        }
      }
    },
    "Freeze %@? It stays an admin in name, but nothing it signs counts until the root unfreezes it." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заморозить %@? Он останется админом по имени, но ничего из подписанного им не будет действовать, пока корень его не разморозит."
          }
        }
      }
    },
    "Freeze this admin" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заморозить этого админа"
          }
        }
      }
    },
    "Latest": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Последнее"
          }
        }
      }
    },
    "Off": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключено"
          }
        }
      }
    },
    "Open Clipboard Bridge on the iPhone to make or join a group.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте Clipboard Bridge на iPhone, чтобы создать группу или войти в неё."
          }
        }
      }
    },
    "Open Clipboard Bridge on the iPhone, then try again.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте Clipboard Bridge на iPhone и попробуйте снова."
          }
        }
      }
    },
    "Remove %@ from the group?" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удалить %@ из группы?"
          }
        }
      }
    },
    "Remove from the group" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удалить из группы"
          }
        }
      }
    },
    "Run %@ on %@?" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запустить %1$@ на %2$@?"
          }
        }
      }
    },
    "Sign" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подписать"
          }
        }
      }
    },
    "Sign the action with this watch's key" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подписать действие ключом этих часов"
          }
        }
      }
    },
    "The action was not signed. Keep the watch on your wrist, then try again." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Действие не подписано. Не снимайте часы с руки и попробуйте снова."
          }
        }
      }
    },
    "The iPhone did not answer. Try again.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone не ответил. Попробуйте снова."
          }
        }
      }
    },
    "The iPhone did not do it. Try again." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone этого не сделал. Попробуйте снова."
          }
        }
      }
    },
    "This watch is an admin of the group." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эти часы админ группы."
          }
        }
      }
    },
    "This watch's iPhone" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone этих часов"
          }
        }
      }
    },
    "Through your hub.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Через ваш хаб."
          }
        }
      }
    },
