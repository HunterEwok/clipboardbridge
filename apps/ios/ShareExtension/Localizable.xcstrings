{
  "sourceLanguage": "en",
  "strings": {
    "The computers did not fetch it within a minute. Try again, or send fewer files.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Компьютеры не забрали это за минуту. Повторите или отправьте меньше файлов."
          }
        }
      }
    },
    "What you shared is larger than 50 MB, more than Share can carry. Send less at a time.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это больше 50 МБ, столько «Поделиться» не унесёт. Отправьте меньше за раз."
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Готово"
          }
        }
      }
    },
    "No computer of your group answered. Are they on, and is this phone on the home network?": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ни один компьютер группы не ответил. Они включены, и телефон в домашней сети?"
          }
        }
      }
    },
    "Open Clipboard Bridge once, then share again.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте Clipboard Bridge один раз и поделитесь снова."
          }
        }
      }
    },
    "Sending failed.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправить не удалось."
          }
        }
      }
    },
    "Sending to your computers…": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправка на ваши компьютеры…"
          }
        }
      }
    },
    "Sent to your computers.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправлено на ваши компьютеры."
          }
        }
      }
    },
    "There is no text to send.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нечего отправлять: нет текста."
          }
        }
      }
    },
    "This phone is in no group yet: open Clipboard Bridge to make one or join one.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот телефон ещё не в группе: откройте Clipboard Bridge, чтобы создать группу или вступить в неё."
          }
        }
      }
    }
  },
  "version": "1.0"
}
