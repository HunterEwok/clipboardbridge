{
  "sourceLanguage": "en",
  "strings": {
    "About": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "О программе"
          }
        }
      }
    },
    "Add": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавить"
          }
        }
      }
    },
    "Add a device": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавить устройство"
          }
        }
      }
    },
    "Adding a computer is not ready yet.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавление компьютера пока не готово."
          }
        }
      }
    },
    "Amber": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Янтарь"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отмена"
          }
        }
      }
    },
    "Change in the system settings": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меняется в настройках системы"
          }
        }
      }
    },
    "Computers": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Компьютеры"
          }
        }
      }
    },
    "Could not reach the computer. Is it on the same network as this phone?": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось связаться с компьютером. Он в той же сети, что и телефон?"
          }
        }
      }
    },
    "Devices": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устройства"
          }
        }
      }
    },
    "Fetched from the computers.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Получено с компьютеров."
          }
        }
      }
    },
    "It will no longer sync with your devices. To add it again, scan its QR code again.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он больше не будет синхронизироваться с вашими устройствами. Чтобы вернуть его, отсканируйте его QR-код снова."
          }
        }
      }
    },
    "Language": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Язык"
          }
        }
      }
    },
    "Light": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Светлая"
          }
        }
      }
    },
    "Midnight": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полночь"
          }
        }
      }
    },
    "No computers connected.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Компьютеры не подключены."
          }
        }
      }
    },
    "Not a clipbridge QR code.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это не QR-код clipbridge."
          }
        }
      }
    },
    "Nothing new to send or fetch.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нечего отправить или получить."
          }
        }
      }
    },
    "One clipboard for your phone and your computers. On a computer, run clipbridge join and scan its QR code.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один буфер обмена для телефона и компьютеров. На компьютере запустите clipbridge join и отсканируйте его QR-код."
          }
        }
      }
    },
    "Paste the text of the QR code of clipbridge join.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставьте текст QR-кода clipbridge join."
          }
        }
      }
    },
    "Point the camera at the QR code of clipbridge join.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наведите камеру на QR-код clipbridge join."
          }
        }
      }
    },
    "QR code text": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст QR-кода"
          }
        }
      }
    },
    "Remove": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить"
          }
        }
      }
    },
    "Remove %@?": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить %@?"
          }
        }
      }
    },
    "Removed. The other devices refuse it from now on.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалено. Остальные устройства больше его не принимают."
          }
        }
      }
    },
    "Scan a computer": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сканировать компьютер"
          }
        }
      }
    },
    "Send or fetch": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправить или получить"
          }
        }
      }
    },
    "Sent to the computers.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправлено на компьютеры."
          }
        }
      }
    },
    "Settings": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройки"
          }
        }
      }
    },
    "Something went wrong. Try again.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что-то пошло не так. Попробуйте ещё раз."
          }
        }
      }
    },
    "Source code and license (AGPL-3.0)": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исходный код и лицензия (AGPL-3.0)"
          }
        }
      }
    },
    "System": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как в системе"
          }
        }
      }
    },
    "Terminal": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Терминал"
          }
        }
      }
    },
    "The code did not match. Run clipbridge join on the computer again and scan the new code.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Код не совпал. Запустите clipbridge join на компьютере ещё раз и отсканируйте новый код."
          }
        }
      }
    },
    "The computer joined but did not confirm it. Check clipbridge status on it.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Компьютер присоединился, но не подтвердил это. Проверьте clipbridge status на нём."
          }
        }
      }
    },
    "The computer refused. Run clipbridge join on it again.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Компьютер отказал. Запустите на нём clipbridge join ещё раз."
          }
        }
      }
    },
    "Theme": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тема"
          }
        }
      }
    },
    "This phone · admin": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот телефон · админ"
          }
        }
      }
    },
    "Version": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Версия"
          }
        }
      }
    },
    "clipbridge": {
      "shouldTranslate": false
    },
    "offline": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "не в сети"
          }
        }
      }
    },
    "online": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "в сети"
          }
        }
      }
    }
  },
  "version": "1.0"
}
