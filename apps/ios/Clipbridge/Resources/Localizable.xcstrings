{
  "sourceLanguage": "en",
  "strings": {
    "About": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "О программе"
          }
        }
      }
    },
    "Add": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавить"
          }
        }
      }
    },
    "Add a computer to your group": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавить компьютер в вашу группу"
          }
        }
      }
    },
    "Add a device": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавить устройство"
          }
        }
      }
    },
    "Adding a computer is not ready yet.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавление компьютера пока не готово."
          }
        }
      }
    },
    "Amber": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Янтарь"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отмена"
          }
        }
      }
    },
    "Change in the system settings": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меняется в настройках системы"
          }
        }
      }
    },
    "Computers": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Компьютеры"
          }
        }
      }
    },
    "Connect this phone to your home Wi-Fi, then try again.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключите телефон к домашнему Wi-Fi и попробуйте снова."
          }
        }
      }
    },
    "Could not reach the computer. Is it on the same network as this phone?": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось связаться с компьютером. Он в той же сети, что и телефон?"
          }
        }
      }
    },
    "Devices": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устройства"
          }
        }
      }
    },
    "Fetched from the computers.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Получено с компьютеров."
          }
        }
      }
    },
    "It will no longer sync with your devices. To add it again, scan its QR code again.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он больше не будет синхронизироваться с вашими устройствами. Чтобы вернуть его, отсканируйте его QR-код снова."
          }
        }
      }
    },
    "Join a group": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войти в группу"
          }
        }
      }
    },
    "Join another phone's group": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войти в группу другого телефона"
          }
        }
      }
    },
    "Language": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Язык"
          }
        }
      }
    },
    "Light": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Светлая"
          }
        }
      }
    },
    "Lost a phone? Make a second phone an admin: on it, tap Join another phone's group, then scan its code here with +.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Потеряли телефон? Сделайте второй телефон админом: нажмите на нём «Войти в группу другого телефона», а здесь отсканируйте его код через +."
          }
        }
      }
    },
    "Midnight": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полночь"
          }
        }
      }
    },
    "No computers connected.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Компьютеры не подключены."
          }
        }
      }
    },
    "No phone scanned the code in five minutes. Try again.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "За пять минут код никто не отсканировал. Попробуйте снова."
          }
        }
      }
    },
    "Not a clipbridge QR code.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это не QR-код clipbridge."
          }
        }
      }
    },
    "Nothing new to send or fetch.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нечего отправить или получить."
          }
        }
      }
    },
    "On your other phone, tap + and scan this code. Keep this screen open.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На другом телефоне нажмите + и отсканируйте этот код. Не закрывайте этот экран."
          }
        }
      }
    },
    "One clipboard for your phone and your computers. On a computer, run clipbridge join and scan its QR code.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один буфер обмена для телефона и компьютеров. На компьютере запустите clipbridge join и отсканируйте его QR-код."
          }
        }
      }
    },
    "Only an admin phone can add or remove devices.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавлять и удалять устройства может только телефон-админ."
          }
        }
      }
    },
    "Only an admin phone can do this.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это может только телефон-админ."
          }
        }
      }
    },
    "Paste the text of the QR code of clipbridge join.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставьте текст QR-кода clipbridge join."
          }
        }
      }
    },
    "Point the camera at the QR code of clipbridge join, or at the one your other phone shows.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наведите камеру на QR-код clipbridge join или на код, который показывает ваш другой телефон."
          }
        }
      }
    },
    "QR code text": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст QR-кода"
          }
        }
      }
    },
    "QR code to join the group": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "QR-код для входа в группу"
          }
        }
      }
    },
    "Remove": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить"
          }
        }
      }
    },
    "Remove %@?": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить %@?"
          }
        }
      }
    },
    "Remove a device from your group": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить устройство из вашей группы"
          }
        }
      }
    },
    "Removed. The other devices refuse it from now on.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалено. Остальные устройства больше его не принимают."
          }
        }
      }
    },
    "Renew this phone's certificate": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продлить сертификат этого телефона"
          }
        }
      }
    },
    "Scan a computer": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сканировать компьютер"
          }
        }
      }
    },
    "Send or fetch": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправить или получить"
          }
        }
      }
    },
    "Sent to the computers.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправлено на компьютеры."
          }
        }
      }
    },
    "Settings": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройки"
          }
        }
      }
    },
    "Something went wrong. Try again.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что-то пошло не так. Попробуйте ещё раз."
          }
        }
      }
    },
    "Source code and license (AGPL-3.0)": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исходный код и лицензия (AGPL-3.0)"
          }
        }
      }
    },
    "System": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как в системе"
          }
        }
      }
    },
    "Terminal": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Терминал"
          }
        }
      }
    },
    "The code did not match. Run clipbridge join on the computer again and scan the new code.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Код не совпал. Запустите clipbridge join на компьютере ещё раз и отсканируйте новый код."
          }
        }
      }
    },
    "The computer joined but did not confirm it. Check clipbridge status on it.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Компьютер присоединился, но не подтвердил это. Проверьте clipbridge status на нём."
          }
        }
      }
    },
    "The computer refused. Run clipbridge join on it again.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Компьютер отказал. Запустите на нём clipbridge join ещё раз."
          }
        }
      }
    },
    "The other phone's group could not be joined. Try again.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось войти в группу другого телефона. Попробуйте снова."
          }
        }
      }
    },
    "The phone that made the group cannot be removed yet.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Телефон, создавший группу, пока нельзя удалить."
          }
        }
      }
    },
    "Theme": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тема"
          }
        }
      }
    },
    "This phone": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот телефон"
          }
        }
      }
    },
    "This phone · admin": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот телефон · админ"
          }
        }
      }
    },
    "Too many wrong codes. Try again with a new code.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слишком много неверных кодов. Попробуйте снова с новым кодом."
          }
        }
      }
    },
    "Version": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Версия"
          }
        }
      }
    },
    "admin": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "админ"
          }
        }
      }
    },
    "clipbridge": {
      "shouldTranslate": false
    },
    "offline": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "не в сети"
          }
        }
      }
    },
    "online": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "в сети"
          }
        }
      }
    }
  },
  "version": "1.0"
}
