<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyLists-1.0.dtd">
<!-- SPDX-License-Identifier: AGPL-3.0-only -->
<!-- The app and its share extension share the group's file (the app group) and this phone's
     member key (the first keychain access group, where new keys go). Release builds only:
     both need the Apple developer account; debug builds signed ad hoc go without. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.io.github.hunterewok.clipboardbridge</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)io.github.hunterewok.clipboardbridge.shared</string>
	</array>
</dict>
</plist>
