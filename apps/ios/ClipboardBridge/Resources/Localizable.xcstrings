{
  "sourceLanguage": "en",
  "strings": {
    "%@ is an admin now.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ теперь админ."
          }
        }
      }
    },
    "%@ joined the group.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ теперь в группе."
          }
        }
      }
    },
    "%@ took the group over: it holds the group's root now.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ забрал группу себе: теперь он создатель группы."
          }
        }
      }
    },
    "%@ was frozen: the others refuse it until an admin unfreezes it.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ заморожен: остальные его не принимают, пока админ его не разморозит."
          }
        }
      }
    },
    "%@ was removed from the group.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ больше не в группе: устройство удалено."
          }
        }
      }
    },
    "%@ was unfrozen.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ разморожен."
          }
        }
      }
    },
    "%lld of %lld online": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld из %lld в сети"
          }
        }
      }
    },
    "A device became an admin": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устройство стало админом"
          }
        }
      }
    },
    "A device joined or was removed": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устройство добавлено или удалено"
          }
        }
      }
    },
    "A device was frozen or unfrozen": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устройство заморожено или разморожено"
          }
        }
      }
    },
    "A name has 1 to 64 characters.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В имени от 1 до 64 символов."
          }
        }
      }
    },
    "About": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "О программе"
          }
        }
      }
    },
    "Add": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавить"
          }
        }
      }
    },
    "Add a computer to your group": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавить компьютер в вашу группу"
          }
        }
      }
    },
    "Add a device": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавить устройство"
          }
        }
      }
    },
    "Adding a computer is not ready yet.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавление компьютера пока не готово."
          }
        }
      }
    },
    "Adding a device…": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляю устройство…"
          }
        }
      }
    },
    "Amber": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Янтарь"
          }
        }
      }
    },
    "Another admin froze this computer, as one does with a stolen one: it changes nothing and the others refuse it. Unfreeze it only if it is in safe hands; otherwise remove it.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Другой админ заморозил этот компьютер, как делают с украденным: он ничего не меняет, и остальные его не принимают. Размораживайте, только если он в надёжных руках, иначе удалите его."
          }
        }
      }
    },
    "At home: syncing directly.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дома: синхронизация напрямую."
          }
        }
      }
    },
    "Away from home": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вне дома"
          }
        }
      }
    },
    "Away from home: through your hub": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вне дома: через ваш хаб"
          }
        }
      }
    },
    "Board": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Плата"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отмена"
          }
        }
      }
    },
    "Clipboard Bridge": {
      "shouldTranslate": false
    },
    "Close": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрыть"
          }
        }
      }
    },
    "Colour": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цвет"
          }
        }
      }
    },
    "Computer": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Компьютер"
          }
        }
      }
    },
    "Connect a new device": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключить новое устройство"
          }
        }
      }
    },
    "Connect this phone to your home Wi-Fi, then try again.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключите телефон к домашнему Wi-Fi и попробуйте снова."
          }
        }
      }
    },
    "Connected to the hub through the tunnel.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключено к хабу через туннель."
          }
        }
      }
    },
    "Connecting to the device…": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключение к устройству…"
          }
        }
      }
    },
    "Connecting to the hub through the tunnel…": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключение к хабу через туннель…"
          }
        }
      }
    },
    "Coral": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коралл"
          }
        }
      }
    },
    "Could not reach the computer. Is it on the same network as this phone, and does its firewall let Clipboard Bridge in?": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось связаться с компьютером. Он в той же сети, что и телефон, и пропускает ли его файрвол Clipboard Bridge?"
          }
        }
      }
    },
    "Could not read the clipboard, so it was left as it is. Allow pasting for Clipboard Bridge, or copy the text again.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать буфер обмена, поэтому он оставлен как есть. Разрешите Clipboard Bridge вставку или скопируйте текст ещё раз."
          }
        }
      }
    },
    "Dark": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тёмная"
          }
        }
      }
    },
    "Device": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устройство"
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Готово"
          }
        }
      }
    },
    "Error messages show the error underneath them, to find out what failed. Tap the version seven times to see this switch.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Под сообщением об ошибке показывается сама ошибка, чтобы понять, что не так. Этот переключатель появляется после семи нажатий на версию."
          }
        }
      }
    },
    "Every device of the group shows the new name.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все устройства группы покажут новое имя."
          }
        }
      }
    },
    "Fetched from the computers.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Получено с компьютеров."
          }
        }
      }
    },
    "Full member": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полный участник"
          }
        }
      }
    },
    "Game console": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Игровая приставка"
          }
        }
      }
    },
    "Graphite": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Графит"
          }
        }
      }
    },
    "I already use Clipboard Bridge on another phone": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У меня уже есть Clipboard Bridge на другом телефоне"
          }
        }
      }
    },
    "In the group": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В группе"
          }
        }
      }
    },
    "It can then add and remove devices with cbb pair and cbb revoke. Its key is a file on the computer, so do this only for a computer you keep safe.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тогда он сможет добавлять и удалять устройства командами cbb pair и cbb revoke. Его ключ хранится в файле на компьютере, поэтому делайте так только для компьютера, который надёжно защищён."
          }
        }
      }
    },
    "It is an admin again.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он снова админ."
          }
        }
      }
    },
    "It is an admin now: it adds and removes devices with cbb pair and cbb revoke.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Теперь это админ: он добавляет и удаляет устройства командами cbb pair и cbb revoke."
          }
        }
      }
    },
    "It made its own secret key, which never leaves it and lets your devices recognise this phone. Now connect a device: tap Connect a new device and scan the QR code it shows.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он создал свой секретный ключ: ключ никогда не покидает телефон, и по нему ваши устройства узнают этот телефон. Теперь подключите устройство: нажмите «Подключить новое устройство» и отсканируйте QR-код, который оно покажет."
          }
        }
      }
    },
    "It made the group. This phone takes the group over with a new key, and the other devices follow it.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот телефон создал группу. Ваш телефон забирает группу себе с новым ключом, остальные устройства переходят за ним."
          }
        }
      }
    },
    "It will no longer sync with your devices. To add it again, scan its QR code again.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он больше не будет синхронизироваться с вашими устройствами. Чтобы вернуть его, отсканируйте его QR-код снова."
          }
        }
      }
    },
    "Its copies go to the group, and the group's come to it.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Его копии уходят в группу, копии группы приходят к нему."
          }
        }
      }
    },
    "Its copies go to the group; the group's do not come.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Его копии уходят в группу, копии группы не приходят."
          }
        }
      }
    },
    "Its copies stay on it and the group's do not come; sending or fetching by hand still works.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Его копии остаются на нём, копии группы не приходят; отправить или забрать вручную по-прежнему можно."
          }
        }
      }
    },
    "Join a group": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войти в группу"
          }
        }
      }
    },
    "Language": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Язык"
          }
        }
      }
    },
    "Laptop": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ноутбук"
          }
        }
      }
    },
    "Light": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Светлая"
          }
        }
      }
    },
    "Lime": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лайм"
          }
        }
      }
    },
    "List": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Список"
          }
        }
      }
    },
    "Lite member": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лёгкий участник"
          }
        }
      }
    },
    "Lost a phone? Make a second phone an admin: on it, tap I already use Clipboard Bridge on another phone, then scan its code here with +.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Потеряли телефон? Сделайте второй телефон админом: на нём нажмите «У меня уже есть Clipboard Bridge на другом телефоне» и отсканируйте его код здесь через +."
          }
        }
      }
    },
    "MAC address": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "MAC-адрес"
          }
        }
      }
    },
    "Make %@ an admin?": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сделать %@ админом?"
          }
        }
      }
    },
    "Make a computer an admin": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сделать компьютер админом"
          }
        }
      }
    },
    "Make it an admin": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сделать админом"
          }
        }
      }
    },
    "Menu": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меню"
          }
        }
      }
    },
    "Midnight": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полночь"
          }
        }
      }
    },
    "Name": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имя"
          }
        }
      }
    },
    "No computers connected.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Компьютеры не подключены."
          }
        }
      }
    },
    "No phone scanned the code in five minutes. Try again.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "За пять минут код никто не отсканировал. Попробуйте снова."
          }
        }
      }
    },
    "Not a Clipboard Bridge QR code.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это не QR-код clipboardbridge."
          }
        }
      }
    },
    "Nothing new to send or fetch.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нечего отправить или получить."
          }
        }
      }
    },
    "Notifications": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомления"
          }
        }
      }
    },
    "Ocean": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Океан"
          }
        }
      }
    },
    "Off": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключено"
          }
        }
      }
    },
    "On a computer, run cbb pair and scan the code it shows.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На компьютере запустите cbb pair и отсканируйте код, который он покажет."
          }
        }
      }
    },
    "On your other phone, tap + and scan this code. Keep this screen open.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На другом телефоне нажмите + и отсканируйте этот код. Не закрывайте этот экран."
          }
        }
      }
    },
    "One clipboard for this phone and your computers.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один буфер обмена для этого телефона и ваших компьютеров."
          }
        }
      }
    },
    "Only an admin phone can add or remove devices.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавлять и удалять устройства может только телефон-админ."
          }
        }
      }
    },
    "Only an admin phone can do this.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это может только телефон-админ."
          }
        }
      }
    },
    "Opens Clipboard Bridge and sends what this phone copied to your computers, or fetches what a computer copied a moment ago.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает Clipboard Bridge и отправляет скопированное на телефоне на ваши компьютеры или забирает то, что компьютер скопировал только что."
          }
        }
      }
    },
    "Operating system": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Операционная система"
          }
        }
      }
    },
    "Orbit": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Орбита"
          }
        }
      }
    },
    "Paste the text of the QR code of cbb pair.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставьте текст QR-кода cbb pair."
          }
        }
      }
    },
    "Phone": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Телефон"
          }
        }
      }
    },
    "Phone app": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение на телефоне"
          }
        }
      }
    },
    "Point the camera at the QR code of cbb pair, or at the one your other phone shows.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наведите камеру на QR-код cbb pair или на код, который показывает ваш другой телефон."
          }
        }
      }
    },
    "QR code text": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст QR-кода"
          }
        }
