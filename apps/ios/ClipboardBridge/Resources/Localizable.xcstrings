      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "заморожен"
          }
        }
      }
    },
    "hidden by the system": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "скрыт системой"
          }
        }
      }
    },
    "offline": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
