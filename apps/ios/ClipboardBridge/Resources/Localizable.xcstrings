{
  "sourceLanguage": "en",
  "strings": {
    "Sent to %@.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправлено на %@."
          }
        }
      }
    },
    "Ready to paste: “%@” from %@.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Можно вставлять: «%@» с %@."
          }
        }
      }
    },
    "Ready to paste, from %@.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Можно вставлять, получено с %@."
          }
        }
      }
    },
    "Ready to paste.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Можно вставлять."
          }
        }
      }
    },
    "Connecting to the computers…": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключаюсь к компьютерам…"
          }
        }
      }
    },
    "Syncing…": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронизирую…"
          }
        }
      }
    },
    "Void both histories" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отменить обе истории"
          }
        }
      }
    },
    "Cancel the claim" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отменить заявку"
          }
        }
      }
    },
    "Remove %@" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удалить %@"
          }
        }
      }
    },
    "The group's root decides." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Решает корень группы."
          }
        }
      }
    },
    "devices unknown here" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "устройства, неизвестные здесь"
          }
        }
      }
    },
    "The group is stopped: its devices exchange only their records, no clipboard, until the group's root decides." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Группа остановлена: устройства обмениваются только записями, без буфера обмена, пока корень группы не решит."
          }
        }
      }
    },
    "The group sends no secrets until its root decides." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Группа не пересылает секреты, пока её корень не решит."
          }
        }
      }
    },
    "%@ signed two histories with one key, as a stolen key or a restore from a backup would." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: две истории, подписанные одним ключом. Так бывает при краже ключа или после восстановления из резервной копии."
          }
        }
      }
    },
    "Admins removed or froze each other without seeing it: %@. The root removes one of them." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Админы удалили или заморозили друг друга, не зная об этом: %@. Корень удаляет одного из них."
          }
        }
      }
    },
    "Two claims to take the group over: %@." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Две заявки на передачу группы: %@."
          }
        }
      }
    },
    "%@ claims the group, to take it over from its root." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ хочет забрать группу у корня."
          }
        }
      }
    },
    "%@ claims the group, to take it over from its root: it takes effect in %@." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ хочет забрать группу у корня: это произойдёт через %2$@."
          }
        }
      }
    },
    "%@ claims the group, and the group is stopped until its root decides." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ хочет забрать группу, и группа остановлена, пока корень не решит."
          }
        }
      }
    },
    "The group holds %lld records of a later version: update the app to read them." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В группе есть записи более новой версии (%lld): обновите приложение, чтобы их прочитать."
          }
        }
      }
    },
    "The claim is cancelled. The other devices hear of it as soon as they connect." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заявка отменена. Остальные устройства узнают об этом, как только подключатся."
          }
        }
      }
    },
    "Both histories are void. The device signs its records again by itself." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обе истории отменены. Устройство само подпишет свои записи заново."
          }
        }
      }
    },
    "Resolve a conflict in your group" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешить конфликт в группе"
          }
        }
      }
    },
    "Arrange" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Упорядочить"
          }
        }
      }
    },
    "New collection…" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новая коллекция…"
          }
        }
      }
    },
    "Move to collection" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В коллекцию"
          }
        }
      }
    },
    "Take out of collection" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Убрать из коллекции"
          }
        }
      }
    },
    "Rename collection…" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переименовать коллекцию…"
          }
        }
      }
    },
    "Ungroup" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разгруппировать"
          }
        }
      }
    },
    "Move to start" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В начало"
          }
        }
      }
    },
    "Move to end" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В конец"
          }
        }
      }
    },
    "Move earlier" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переместить раньше"
          }
        }
      }
    },
    "Move later" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переместить позже"
          }
        }
      }
    },
    "Drag devices here" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетащите сюда устройства"
          }
        }
      }
    },
    "collection, %lld of %lld online, needs attention" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "коллекция, %lld из %lld в сети, требует внимания"
          }
        }
      }
    },
    "collection, %lld of %lld online" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "коллекция, %lld из %lld в сети"
          }
        }
      }
    },
    "Drag devices here, or add them with Move to collection in a device's menu." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетащите сюда устройства или добавьте их пунктом «В коллекцию» в меню устройства."
          }
        }
      }
    },
    "Drag to arrange. Drop a device on a collection to put it in." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетаскивайте плитки, чтобы расставить их. Бросьте устройство на коллекцию, чтобы положить его туда."
          }
        }
      }
    },
    "Collection name" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Название коллекции"
          }
        }
      }
    },
    "Save" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохранить"
          }
        }
      }
    },
    "Rename collection" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переименовать коллекцию"
          }
        }
      }
    },
    "New collection" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новая коллекция"
          }
        }
      }
    },
    "The tiles stay as they were: that change does not fit." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Плитки остались как были: такое изменение не подходит."
          }
        }
      }
    },
    "No devices match." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подходящих устройств нет."
          }
        }
      }
    },
    "Done arranging" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Закончить расстановку"
          }
        }
      }
    },
    "Arrange devices" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Упорядочить устройства"
          }
        }
      }
    },
    "Back to the group's order" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вернуть порядок группы"
          }
        }
      }
    },
    "Search devices" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поиск устройств"
          }
        }
      }
    },
    "Online" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В сети"
          }
        }
      }
    },
    "Needs attention" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Требует внимания"
          }
        }
      }
    },
    "Apple Watch" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Watch"
          }
        }
      }
    },
    "Make the watch an admin" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сделать часы админом"
          }
        }
      }
    },
    "Open Clipboard Bridge on the watch, then try again." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Откройте Clipboard Bridge на часах и попробуйте снова."
          }
        }
      }
    },
    "Saved in Files, On My iPhone, Clipboard Bridge.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранено в «Файлах»: «На iPhone», Clipboard Bridge."
          }
        }
      }
    },
    "Could not get the image from the computers. Copy it there again, then try again.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось получить картинку с компьютеров. Скопируйте её там ещё раз и повторите."
          }
        }
      }
    },
    "The iPhone is not connected to that device. Open Clipboard Bridge on the iPhone, then try again." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone не подключён к этому устройству. Откройте Clipboard Bridge на iPhone и попробуйте снова."
          }
        }
      }
    },
    "The watch is an admin now. It can freeze an admin computer, remove a device that is no admin and turn things off." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Теперь часы админ. Они могут заморозить компьютер-админ, удалить устройство, которое не админ, и выключать функции."
          }
        }
      }
    },
    "The watch needs a passcode and wrist detection, and must be on your wrist. Turn them on in the Watch app on this iPhone." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Часам нужны код-пароль и распознавание запястья, и они должны быть на руке. Включите их в приложении Watch на этом iPhone."
          }
        }
      }
    },
    "This image is larger than 100 MB, so it stays on the computer.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Картинка больше 100 МБ, поэтому она осталась на компьютере."
          }
        }
      }
    },
    "%@ is an admin now.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ теперь админ."
          }
        }
      }
    },
    "%@ joined the group.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ теперь в группе."
          }
        }
      }
    },
    "%@ took the group over: it holds the group's root now.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ забрал группу себе: теперь он создатель группы."
          }
        }
      }
    },
    "%@ was frozen: the others refuse it until an admin unfreezes it.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ заморожен: остальные его не принимают, пока админ его не разморозит."
          }
        }
      }
    },
    "%@ was removed from the group.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ больше не в группе: устройство удалено."
          }
        }
      }
    },
    "%@ was unfrozen.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ разморожен."
          }
        }
      }
    },
    "%lld of %lld online": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld из %lld в сети"
          }
        }
      }
    },
    "A device became an admin": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устройство стало админом"
          }
        }
      }
    },
    "A device joined or was removed": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устройство добавлено или удалено"
          }
        }
      }
    },
    "A device was frozen or unfrozen": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устройство заморожено или разморожено"
          }
        }
      }
    },
    "A name has 1 to 64 characters.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В имени от 1 до 64 символов."
          }
        }
      }
    },
    "A paste suits most apps; typing suits those that take no paste, and only up to 4 KB. Enter runs a command in a terminal, so the computer takes it only when its user allowed that. A secret leaves no trace in the computer's log or clipboard." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вставка подходит большинству приложений, а набор по клавишам нужен тем, что вставку не принимают, и только до 4 КБ. Enter в терминале запускает команду, поэтому компьютер примет его, только если его пользователь это разрешил. Секрет не остаётся ни в журнале компьютера, ни в его буфере."
          }
        }
      }
    },
    "A secret" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Секрет"
          }
        }
      }
    },
    "About": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "О программе"
          }
        }
      }
    },
    "Add": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавить"
          }
        }
      }
    },
    "Add a computer to your group": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавить компьютер в вашу группу"
          }
        }
      }
    },
    "Add a device": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавить устройство"
          }
        }
      }
    },
    "Adding a computer is not ready yet.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавление компьютера пока не готово."
          }
        }
      }
    },
    "Adding a device…": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляю устройство…"
          }
        }
      }
    },
    "Amber": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Янтарь"
          }
        }
      }
    },
    "Another admin froze this computer, as one does with a stolen one: it changes nothing and the others refuse it. Unfreeze it only if it is in safe hands; otherwise remove it.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Другой админ заморозил этот компьютер, как делают с украденным: он ничего не меняет, и остальные его не принимают. Размораживайте, только если он в надёжных руках, иначе удалите его."
          }
        }
      }
    },
    "At home: syncing directly.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дома: синхронизация напрямую."
          }
        }
      }
    },
    "Away from home": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вне дома"
          }
        }
      }
    },
    "Away from home: through your hub": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вне дома: через ваш хаб"
          }
        }
      }
    },
    "Board": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Плата"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отмена"
          }
        }
      }
    },
    "Clipboard Bridge": {
      "shouldTranslate": false
    },
    "Close": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрыть"
          }
        }
      }
    },
    "Colour": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цвет"
          }
        }
      }
    },
    "Computer": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Компьютер"
          }
        }
      }
    },
    "Connect a new device": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключить новое устройство"
          }
        }
      }
    },
    "Connect this phone to your home Wi-Fi, then try again.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключите телефон к домашнему Wi-Fi и попробуйте снова."
          }
        }
      }
    },
    "Connected to the hub through the tunnel.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключено к хабу через туннель."
          }
        }
      }
    },
    "Connecting to the device…": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключение к устройству…"
          }
        }
      }
    },
    "Connecting to the hub through the tunnel…": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключение к хабу через туннель…"
          }
        }
      }
    },
    "Coral": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коралл"
          }
        }
      }
    },
    "Could not reach the computer. Is it on the same network as this phone, and does its firewall let Clipboard Bridge in?": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось связаться с компьютером. Он в той же сети, что и телефон, и пропускает ли его файрвол Clipboard Bridge?"
          }
        }
      }
    },
    "Could not read the clipboard, so it was left as it is. Allow pasting for Clipboard Bridge, or copy the text again.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать буфер обмена, поэтому он оставлен как есть. Разрешите Clipboard Bridge вставку или скопируйте текст ещё раз."
          }
        }
      }
    },
    "Dark": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тёмная"
          }
        }
      }
    },
    "Device": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устройство"
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Готово"
          }
        }
      }
    },
    "Error messages show the error underneath them, to find out what failed. Tap the version seven times to see this switch.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Под сообщением об ошибке показывается сама ошибка, чтобы понять, что не так. Этот переключатель появляется после семи нажатий на версию."
          }
        }
      }
    },
    "Every device of the group shows the new name.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все устройства группы покажут новое имя."
          }
        }
      }
    },
    "Full member": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полный участник"
          }
        }
      }
    },
    "This computer is installed without root, so any of its programs can read its keys. It can never be an admin.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот компьютер установлен без root, поэтому его ключи может прочитать любая его программа. Он никогда не станет админом."
          }
        }
      }
    },
    "Full member, rootless": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полный участник, rootless"
          }
        }
      }
    },
    "Game console": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Игровая приставка"
          }
        }
      }
    },
    "Graphite": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Графит"
          }
        }
      }
    },
    "I already use Clipboard Bridge on another phone": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У меня уже есть Clipboard Bridge на другом телефоне"
          }
        }
      }
    },
    "In the group": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В группе"
          }
        }
      }
    },
    "It can then add and remove devices with cbb pair and cbb revoke. Its keys are in its hardware, which never lets them out.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тогда он сможет добавлять и удалять устройства командами cbb pair и cbb revoke. Его ключи хранятся в его железе и никогда его не покидают."
          }
        }
      }
    },
    "It can then add and remove devices with cbb pair and cbb revoke. Its keys sit in a file on the computer: whoever copies that file can act as an admin until another admin removes it. Do this only for a computer you keep safe.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тогда он сможет добавлять и удалять устройства командами cbb pair и cbb revoke. Его ключи лежат в файле на компьютере: кто скопирует этот файл, сможет действовать как админ, пока другой админ его не удалит. Делайте так только для компьютера, который надёжно защищён."
          }
        }
      }
    },
    "It goes where %@'s keyboard focus is, once its user turned remote paste on there." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Текст попадёт туда, где фокус клавиатуры устройства %@, если его пользователь включил там удалённую вставку."
          }
        }
      }
    },
    "It is an admin again.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он снова админ."
          }
        }
      }
    },
    "It is an admin now: it adds and removes devices with cbb pair and cbb revoke.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Теперь это админ: он добавляет и удаляет устройства командами cbb pair и cbb revoke."
          }
        }
      }
    },
    "It made its own secret key, which never leaves it and lets your devices recognise this phone. Now connect a device: tap Connect a new device and scan the QR code it shows.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он создал свой секретный ключ: ключ никогда не покидает телефон, и по нему ваши устройства узнают этот телефон. Теперь подключите устройство: нажмите «Подключить новое устройство» и отсканируйте QR-код, который оно покажет."
          }
        }
      }
    },
    "It made the group. This phone takes the group over with a new key, and the other devices follow it.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот телефон создал группу. Ваш телефон забирает группу себе с новым ключом, остальные устройства переходят за ним."
          }
        }
      }
    },
    "It will no longer sync with your devices. To add it again, scan its QR code again.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он больше не будет синхронизироваться с вашими устройствами. Чтобы вернуть его, отсканируйте его QR-код снова."
          }
        }
      }
    },
    "Its copies go to the group, and the group's come to it.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Его копии уходят в группу, копии группы приходят к нему."
          }
        }
      }
    },
    "Its copies go to the group; the group's do not come.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Его копии уходят в группу, копии группы не приходят."
          }
        }
      }
    },
    "Its copies stay on it and the group's do not come; sending or fetching by hand still works.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Его копии остаются на нём, копии группы не приходят; отправить или забрать вручную по-прежнему можно."
          }
        }
      }
    },
    "Join a group": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войти в группу"
          }
        }
      }
    },
