<!-- What only the full build has (docs/apps.md, "F-Droid"); the build merges it into src/main's. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The update of an APK installed from a release (ApkUpdate): the system's installer, and no question after the first. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <application>
        <!-- The Wear OS watch's away switch, through Google Play services. -->
        <service
            android:name=".WatchListener"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:host="*"
                    android:pathPrefix="/cbb/"
                    android:scheme="wear" />
            </intent-filter>
        </service>
    </application>

</manifest>
