<!-- The TV launcher's banner, 320 by 180 pixels at xhdpi: the icon's clipboard and the app's name on the icon's fill. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ic_launcher_background" />
        </shape>
    </item>
    <item
        android:width="90dp"
        android:height="90dp"
        android:drawable="@mipmap/ic_launcher_foreground"
        android:gravity="start|center_vertical"
        android:left="4dp" />
    <item
        android:width="64dp"
        android:height="32dp"
        android:drawable="@drawable/banner_name"
        android:gravity="end|center_vertical"
        android:right="14dp" />
</layer-list>
