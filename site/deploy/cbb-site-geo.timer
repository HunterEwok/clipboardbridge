# DB-IP publishes the Lite database at the start of each month.

[Unit]
Description=Update the cbb.tools country database every month

[Timer]
OnCalendar=*-*-03 04:00:00 UTC
Persistent=true
RandomizedDelaySec=1h

[Install]
WantedBy=timers.target
