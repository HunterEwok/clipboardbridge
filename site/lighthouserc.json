{
  "ci": {
    "collect": {
      "staticDistDir": "out",
      "url": [
        "http://localhost/en/",
        "http://localhost/ar/",
        "http://localhost/en/download.html",
        "http://localhost/ru/privacy.html"
      ],
      "numberOfRuns": 3,
      "settings": { "chromeFlags": "--no-sandbox --headless=new" }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9, "aggregationMethod": "median" }],
        "categories:accessibility": ["error", { "minScore": 0.95, "aggregationMethod": "median" }],
        "categories:seo": ["error", { "minScore": 0.9, "aggregationMethod": "median" }],
        "categories:best-practices": ["warn", { "minScore": 0.9, "aggregationMethod": "median" }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": "out-lighthouse" }
  }
}
