# The bench's root helper on a Mac, installed by tools/bench/setup-mac.sh as
# /usr/local/libexec/cbbbench/cbbbench-root: the steps of the bench that need
# root, each fixed, so the sudoers rule names this one program.
#
#   cbbbench-root purge            uninstall.sh --purge of the installed copy
#   cbbbench-root install ARCHIVE [SUMS SIG]
#                                  install a release archive, only one whose
#                                  SHA-256 is in sums the bench's signing key
#                                  signed (SUMS, SIG), or in the sums trusted
#                                  with setup-mac.sh trust
#   cbbbench-root grep RUN         files in the state directory or /tmp that hold RUN
#   cbbbench-root perms            files in the state directory open to others
#   cbbbench-root stranger         cbb status as the user nobody (S11)
#   cbbbench-root logs             the service's log
#   cbbbench-root fill-log         fill the service's log past 1 MiB and
#                                  restart the service, which moves it aside
#   cbbbench-root log-sizes        the sizes of service.log and service.log.1
set -eu

dir=/usr/local/libexec/cbbbench
state="/Library/Application Support/clipboardbridge/state"

usage() {
	echo "usage: cbbbench-root purge | install ARCHIVE [SUMS SIG] | grep RUN | perms | stranger | logs | fill-log | log-sizes" >&2
	exit 2
}

case ${1:-} in
purge)
	[ $# -eq 1 ] || usage
	if [ -f /usr/local/share/clipboardbridge/uninstall.sh ]; then
		sh /usr/local/share/clipboardbridge/uninstall.sh --purge
	fi
	;;
install)
	[ $# -eq 2 ] || [ $# -eq 4 ] || usage
	work=$(mktemp -d)
	trap 'rm -rf "$work"' EXIT
	# Each file is copied first, so it cannot change between the check and
	# the install.
	cp "$2" "$work/archive.tar.gz"
	sums=$dir/SHA256SUMS
	if [ $# -eq 4 ]; then
		cp "$3" "$work/SHA256SUMS"
		cp "$4" "$work/SHA256SUMS.sig"
		[ -f "$dir/allowed_signers" ] || {
			echo "cbbbench-root: no bench signing key; set one up: sudo sh tools/bench/setup-mac.sh setup -signer KEY.pub" >&2
			exit 1
		}
		ssh-keygen -Y verify -f "$dir/allowed_signers" -I cbbbench -n cbbbench \
			-s "$work/SHA256SUMS.sig" <"$work/SHA256SUMS" >/dev/null || {
			echo "cbbbench-root: the build's SHA256SUMS is not signed by the bench's key" >&2
			exit 1
		}
		sums=$work/SHA256SUMS
	fi
	sum=$(shasum -a 256 "$work/archive.tar.gz" | cut -d' ' -f1)
	if ! grep -q "^$sum " "$sums" 2>/dev/null; then
		echo "cbbbench-root: the archive's SHA-256 $sum is not in the build's signed sums or in $dir/SHA256SUMS" >&2
		exit 1
	fi
	tar -xzf "$work/archive.tar.gz" -C "$work"
	sh "$work/clipboardbridge/packaging/macos/install.sh" --express "$work/clipboardbridge/cbb"
	;;
grep)
	[ $# -eq 2 ] || usage
	case $2 in '' | -* | *[!A-Za-z0-9T._-]*) usage ;; esac
	# /tmp is /private/tmp; text files only, so that a big /tmp stays quick.
	grep -r -l -I -F -- "$2" "$state" /private/tmp 2>/dev/null || true
	;;
perms)
	[ $# -eq 1 ] || usage
	find "$state" -mindepth 1 \( -perm -g=r -o -perm -g=w -o -perm -o=r -o -perm -o=w \)
	;;
stranger)
	[ $# -eq 1 ] || usage
	cd /
	exec sudo -u nobody /usr/local/bin/cbb status
	;;
logs)
	[ $# -eq 1 ] || usage
	cat /Library/Logs/clipboardbridge/service.log
	;;
fill-log)
	[ $# -eq 1 ] || usage
	log=/Library/Logs/clipboardbridge/service.log
	rm -f "$log.1"
	line="2026-01-01 00:00:00 cbb: the bench fills the log to rotate it $(printf '%060d' 0)"
	# 1 MiB and a little more, in lines of 100 bytes.
	yes "$line" | head -n 10496 >>"$log"
	launchctl kickstart -k system/io.github.hunterewok.clipboardbridge
	;;
log-sizes)
	[ $# -eq 1 ] || usage
	for f in /Library/Logs/clipboardbridge/service.log /Library/Logs/clipboardbridge/service.log.1; do
		if [ -f "$f" ]; then stat -f %z "$f"; else echo -1; fi
	done
	;;
*)
	usage
	;;
esac
