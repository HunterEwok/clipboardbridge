# The service of a rootless install (install.sh --rootless, D-79), as the
# user's own systemd user unit. It runs as the user, so every program of
# the user can read its keys; such a device is never the group's root, an
# admin or a hub. A system install (sudo sh install.sh) keeps the service
# under an account and a sandbox of its own instead.
[Unit]
Description=Clipboard Bridge shared clipboard (rootless)
Documentation=https://github.com/HunterEwok/clipboardbridge/blob/main/docs/guide/install.md
After=network-online.target

[Service]
Type=simple
Environment=CBB_ROOTLESS=1
# install.sh --rootless --port N writes CBB_PORT here.
EnvironmentFile=-%E/clipboardbridge/clipboardbridge.env
ExecStart=/usr/local/bin/cbb service
# The control and admin sockets, in $XDG_RUNTIME_DIR/clipboardbridge.
RuntimeDirectory=clipboardbridge
RuntimeDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=2s
NoNewPrivileges=yes
# Secrets live only in memory; none of it goes to swap.
MemorySwapMax=0

[Install]
WantedBy=default.target
