# cbb forward on a server (docs/admin/self-hosting.md): it passes the
# encrypted WireGuard packets of the hubs whose clients cannot reach them
# directly. It holds no group's keys and keeps nothing about the devices: no
# log names an address, a group or a device, and on disk there is only its
# key and a table of hashed tags.
[Unit]
Description=Clipboard Bridge forwarder
Documentation=https://github.com/HunterEwok/clipboardbridge/blob/main/docs/admin/self-hosting.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# -vless-site, -vless-listen and the other flags of cbb forward go in
# CBB_FORWARD_FLAGS in /etc/clipboardbridge/forward.env.
Environment=CBB_FORWARD_FLAGS=
EnvironmentFile=-/etc/clipboardbridge/forward.env
ExecStart=/usr/local/bin/cbb forward $CBB_FORWARD_FLAGS
DynamicUser=yes
StateDirectory=cbb-forward
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=2s

# It needs no privileges: it listens on port 8764. For VLESS on port 443 a
# drop-in sets CapabilityBoundingSet=CAP_NET_BIND_SERVICE,
# AmbientCapabilities=CAP_NET_BIND_SERVICE and PrivateUsers=no: in a user
# namespace of its own the capability would not cover the host's network.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
PrivateUsers=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
MemorySwapMax=0
# No accounting of the addresses it talks to.
IPAccounting=no

[Install]
WantedBy=multi-user.target
