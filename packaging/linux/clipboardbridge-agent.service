# The desktop agent as a systemd user unit, for desktops that start
# graphical-session.target (GNOME, KDE Plasma): the installer restarts it in
# each running session after an update, so the new binary links the
# clipboard without logging out and in. Other desktops start the same
# command from the autostart entry, which these skip.
[Unit]
Description=Clipboard Bridge desktop agent
Documentation=https://github.com/HunterEwok/clipboardbridge
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/local/bin/cbb agent
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
