# cbb relay on a server (docs/reference/self-hosting.md): the meeting point
# for the devices of a group that has no computer to be its hub. It holds no
# group's keys and keeps nothing about the devices: no log names an
# address, a group or a device, and on disk there is only its keys.
[Unit]
Description=Clipboard Bridge blind relay
Documentation=https://github.com/HunterEwok/clipboardbridge/blob/main/docs/reference/self-hosting.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# The groups to serve go in /etc/clipboardbridge/relay.env, as
# CBB_RELAY_FLAGS="-group TAG" (or "-open"); cbb relay takes no other setting.
EnvironmentFile=-/etc/clipboardbridge/relay.env
ExecStart=/usr/local/bin/cbb relay $CBB_RELAY_FLAGS
DynamicUser=yes
StateDirectory=cbb-relay
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=2s

# It needs no privileges: it listens on port 8764.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
PrivateUsers=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
MemorySwapMax=0
# No accounting of the addresses it talks to.
IPAccounting=no

[Install]
WantedBy=multi-user.target
