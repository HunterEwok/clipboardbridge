# The console helper: it puts the remote pastes that an admin sends this
# device into the active text console, where a user is logged in and the
# console is not locked, once the device's user allowed consoles (cbb
# paste-receive on -console). Installed and started by install.sh --console.
# TIOCSTI into a console needs CAP_SYS_ADMIN, its only capability.
[Unit]
Description=Clipboard Bridge remote paste on the text console
Documentation=https://github.com/HunterEwok/clipboardbridge
After=clipboardbridge.service
Wants=clipboardbridge.service

[Service]
Type=simple
ExecStart=/usr/local/bin/cbb paste-helper console
Restart=on-failure
RestartSec=5s
CapabilityBoundingSet=CAP_SYS_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
DevicePolicy=closed
DeviceAllow=char-tty w
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
