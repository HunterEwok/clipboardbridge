#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: AGPL-3.0-only
# Copyright (C) 2026 HunterEwok

# The Clipboard Bridge service on OpenWrt (/etc/init.d/clipboardbridge).
# procd runs cbb service (cbb run for the lite member) as the user
# clipboardbridge, with no capabilities
# and no_new_privs, and starts it again when it stops. The settings are in
# /etc/config/clipboardbridge; the keys in /etc/clipboardbridge/state,
# which sysupgrade keeps.
#
# The service works only on the devices of the zones the settings list
# (CBB_INTERFACES), never on wan. The firewall rules it needs are the
# service's own data, which fw4 reads while the service runs and drops when
# it stops: the member port and mDNS from the listed zones other than lan
# (lan accepts input already), and the hub's UDP port from wan while this
# router is the hub (/etc/clipboardbridge/firewall.hub, which cbb global
# writes through firewall.sh). /etc/config/firewall is never touched.

# shellcheck disable=SC3043 # busybox ash has local
# shellcheck disable=SC2034 # rc.common reads these
START=99
STOP=10
USE_PROCD=1

PROG=/usr/bin/cbb
RUNDIR=/var/run/clipboardbridge
STATEDIR=/etc/clipboardbridge/state
HUBSTATE=/etc/clipboardbridge/firewall.hub
TIMEFLAG=/var/state/clipboardbridge.time

# zone_devices prints the devices of a firewall zone, one per line, without
# the ones that face the internet or a tunnel.
zone_devices() {
	fw4 -q zone "$1" 2>/dev/null | tr ' ' '\n' | while read -r dev; do
		case $dev in
		'' | wan* | pppoe-* | wg* | tun* | awg* | l2tp-* | 6in4-* | gre*) ;;
		*) echo "$dev" ;;
		esac
	done
}

add_zone() {
	case $1 in
	wan | wan6) return ;;
	esac
	zones="$zones $1"
}

# zone_rules publishes the rules the zones other than lan need.
zone_rules() {
	port=$1
	for z in $zones; do
		[ "$z" = lan ] && continue
		json_add_object ""
		json_add_string type rule
		json_add_string name "clipboardbridge member port from $z"
		json_add_string src "$z"
		json_add_string proto tcp
		json_add_string dest_port "$port"
		json_add_string target ACCEPT
		json_close_object
		json_add_object ""
		json_add_string type rule
		json_add_string name "clipboardbridge mDNS from $z"
		json_add_string src "$z"
		json_add_string proto udp
		json_add_string dest_port 5353
		json_add_string target ACCEPT
		json_close_object
	done
}

hub_rule() {
	json_add_object ""
	json_add_string type rule
	json_add_string name "clipboardbridge hub"
	json_add_string src wan
	json_add_string proto udp
	json_add_string dest_port "$1"
	json_add_string target ACCEPT
	json_close_object
}

start_service() {
	local port wait_ntp memlimit zones devices dev hub
	config_load clipboardbridge
	config_get port main port 8764
	config_get wait_ntp main wait_ntp 1
	config_get memlimit main memlimit 64MiB
	zones=
	config_list_foreach main zone add_zone
	[ -n "$zones" ] || zones=lan

	if [ "$wait_ntp" = 1 ] && [ ! -f "$TIMEFLAG" ]; then
		echo "clipboardbridge: waiting for NTP to set the clock; /etc/hotplug.d/ntp starts it" >&2
		return 0
	fi

	devices=
	for z in $zones; do
		for dev in $(zone_devices "$z"); do
			case " $devices " in *" $dev "*) ;; *) devices="$devices $dev" ;; esac
		done
	done
	devices=${devices# }
	if [ -z "$devices" ]; then
		echo "clipboardbridge: the zones$zones have no devices; not starting" >&2
		return 1
	fi

	mkdir -p "$RUNDIR" "$STATEDIR"
	chown clipboardbridge:clipboardbridge "$RUNDIR" "$STATEDIR"
	chmod 0750 "$RUNDIR"
	chmod 0700 "$STATEDIR"

	# The lite member's cbb join reads the list here; it is not started by
	# procd.
	echo "$devices" >"$RUNDIR/interfaces"
	chmod 0644 "$RUNDIR/interfaces"

	procd_open_instance
	if "$PROG" version 2>/dev/null | grep -q "lite member"; then
		procd_set_param command "$PROG" run
		procd_set_param env CBB_PORT="$port" CBB_INTERFACES="$devices" \
			CBB_STATE="$STATEDIR" CBB_SOCKET="$RUNDIR/control.sock"
	else
		procd_set_param command "$PROG" service -state "$STATEDIR" -socket "$RUNDIR/control.sock"
		procd_set_param env CBB_PORT="$port" CBB_INTERFACES="$devices" GOMEMLIMIT="$memlimit"
	fi
	procd_set_param user clipboardbridge
	procd_set_param group clipboardbridge
	procd_set_param no_new_privs 1
	procd_set_param capabilities /etc/capabilities/clipboardbridge.json
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file /etc/config/clipboardbridge "$HUBSTATE"
	# shellcheck disable=SC2086 # one word per device
	procd_set_param netdev $devices

	procd_open_data
	json_add_array firewall
	zone_rules "$port"
	if [ -f "$HUBSTATE" ]; then
		read -r _ hub <"$HUBSTATE" || true
		[ -n "$hub" ] && hub_rule "$hub"
	fi
	json_close_array
	procd_close_data
	procd_close_instance
}

service_triggers() {
	local zones z
	procd_add_reload_trigger clipboardbridge
	# Devices come and go with the network interfaces, which are usually
	# named as their zones.
	config_load clipboardbridge
	zones=
	config_list_foreach main zone add_zone
	for z in ${zones:-lan}; do
		procd_add_reload_interface_trigger "$z"
	done
}
