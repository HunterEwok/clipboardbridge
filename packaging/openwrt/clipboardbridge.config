# Clipboard Bridge (/etc/config/clipboardbridge). After a change:
# /etc/init.d/clipboardbridge reload

config clipboardbridge 'main'
	# The member port, for the devices at home and the phones.
	option port '8764'
	# The firewall zones the service works in: mDNS and the member port
	# answer only on their devices (CBB_INTERFACES). A zone other than lan
	# (an IoT zone, say) also gets a rule for the member port and mDNS while
	# the service runs. wan, and pppoe, WireGuard and tun devices, never count.
	list zone 'lan'
	# Start only once NTP has set the clock: certificates need the time.
	# 0 for a router with a clock that keeps running while it is off.
	option wait_ntp '1'
	# A soft limit for the service's memory (GOMEMLIMIT).
	option memlimit '64MiB'
