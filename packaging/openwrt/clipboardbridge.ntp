#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-only
# Copyright (C) 2026 HunterEwok

# /etc/hotplug.d/ntp/50-clipboardbridge: the first time NTP sets the clock
# after a boot, leave a flag in /var/state, which is in RAM, and start the
# service that waited for it (as dnsmasq does for DNSSEC).

case $ACTION in stratum | step | periodic) ;; *) exit 0 ;; esac
[ -f /var/state/clipboardbridge.time ] && exit 0
mkdir -p /var/state
touch /var/state/clipboardbridge.time
/etc/init.d/clipboardbridge enabled && /etc/init.d/clipboardbridge start
exit 0
