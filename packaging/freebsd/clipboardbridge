# PROVIDE: clipboardbridge
# REQUIRE: NETWORKING ntpd
# KEYWORD: shutdown
#
# The Clipboard Bridge service on FreeBSD; install.sh puts it in
# /usr/local/etc/rc.d and sets clipboardbridge_enable=YES in rc.conf.
# daemon(8) runs cbb service as the user clipboardbridge, starts it again
# 5 s after it stops, and sends its output to syslog. It waits for ntpd,
# whose ntpd_sync_on_start steps the clock first: certificates need the
# right time.
#
# rc.subr reads the variables set here.
# shellcheck disable=SC1091,SC2034

. /etc/rc.subr

name=clipboardbridge
rcvar=clipboardbridge_enable
load_rc_config $name

: "${clipboardbridge_enable:=NO}"
: "${clipboardbridge_user:=clipboardbridge}"
: "${clipboardbridge_group:=clipboardbridge}"

rundir=/var/run/${name}
pidfile=${rundir}/daemon.pid
procname=/usr/sbin/daemon
command=/usr/sbin/daemon
command_args="-f -r -R 5 -S -T ${name} -P ${pidfile} -u ${clipboardbridge_user} /usr/local/bin/cbb service -state /var/db/${name} -socket ${rundir}/control.sock"
clipboardbridge_umask=0007
start_precmd=clipboardbridge_prestart

clipboardbridge_prestart() {
	install -d -o "${clipboardbridge_user}" -g "${clipboardbridge_group}" -m 0750 "${rundir}"
	install -d -o "${clipboardbridge_user}" -g "${clipboardbridge_group}" -m 0700 /var/db/${name}
	# ipfw forgets rules added at run time on a reboot; pf loads its anchor
	# from pf.conf itself.
	if [ -f /usr/local/share/clipboardbridge/firewall.sh ]; then
		sh /usr/local/share/clipboardbridge/firewall.sh reload || true
	fi
}

run_rc_command "$1"
