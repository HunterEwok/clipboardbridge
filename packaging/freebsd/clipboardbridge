#
# PROVIDE: clipboardbridge
# REQUIRE: NETWORKING ntpd
# KEYWORD: shutdown
#
# The Clipboard Bridge service on FreeBSD; install.sh puts it in
# /usr/local/etc/rc.d and sets clipboardbridge_enable=YES in rc.conf.
# daemon(8) runs cbb service, which opens its mDNS sockets as root and then
# runs as the user clipboardbridge (-user), starts it again 5 s after it
# stops, and sends its output to syslog. It waits for ntpd,
# whose ntpd_sync_on_start steps the clock first: certificates need the
# right time.
#
# rc.subr reads the variables set here.
# shellcheck disable=SC1091,SC2034

. /etc/rc.subr

name=clipboardbridge
rcvar=clipboardbridge_enable
load_rc_config $name

: "${clipboardbridge_enable:=NO}"
: "${clipboardbridge_user:=clipboardbridge}"
: "${clipboardbridge_group:=clipboardbridge}"

rundir=/var/run/${name}
pidfile=${rundir}/daemon.pid
procname=/usr/sbin/daemon
command=/usr/sbin/daemon
# cbb must start as root: a socket on port 5353 shares it with avahi or
# another user's responder only when root opened it. So the user goes to
# cbb -user and not to rc.subr, which would run daemon itself through su
# as that user.
cbb_user=${clipboardbridge_user}
cbb_group=${clipboardbridge_group}
unset clipboardbridge_user clipboardbridge_group
command_args="-f -r -R 5 -S -T ${name} -P ${pidfile} /usr/local/bin/cbb service -user ${cbb_user} -state /var/db/${name} -socket ${rundir}/control.sock"
clipboardbridge_umask=0007
start_precmd=clipboardbridge_prestart

clipboardbridge_prestart() {
	install -d -o "${cbb_user}" -g "${cbb_group}" -m 0750 "${rundir}"
	install -d -o "${cbb_user}" -g "${cbb_group}" -m 0700 /var/db/${name}
	# ipfw forgets rules added at run time on a reboot; pf loads its anchor
	# from pf.conf itself.
	if [ -f /usr/local/share/clipboardbridge/firewall.sh ]; then
		sh /usr/local/share/clipboardbridge/firewall.sh reload || true
	fi
}

run_rc_command "$1"
