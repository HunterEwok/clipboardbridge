<!-- The clipbridge service, a LaunchDaemon under the hidden _clipbridge user. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>io.github.hunterewok.clipbridge</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/clipbridge</string>
		<string>service</string>
		<string>-state</string>
		<string>/Library/Application Support/clipbridge/state</string>
		<string>-socket</string>
		<string>/Library/Application Support/clipbridge/control.sock</string>
	</array>
	<key>UserName</key>
	<string>_clipbridge</string>
	<key>GroupName</key>
	<string>_clipbridge</string>
	<key>Umask</key>
	<integer>7</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/Library/Logs/clipbridge/service.log</string>
</dict>
</plist>
