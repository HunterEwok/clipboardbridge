<!-- The clipboardbridge service, a LaunchDaemon under the hidden _clipboardbridge user. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>io.github.hunterewok.clipboardbridge</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/cbb</string>
		<string>service</string>
		<string>-state</string>
		<string>/Library/Application Support/clipboardbridge/state</string>
		<string>-socket</string>
		<string>/Library/Application Support/clipboardbridge/control.sock</string>
	</array>
	<key>UserName</key>
	<string>_clipboardbridge</string>
	<key>GroupName</key>
	<string>_clipboardbridge</string>
	<key>Umask</key>
	<integer>7</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/Library/Logs/clipboardbridge/service.log</string>
</dict>
</plist>
