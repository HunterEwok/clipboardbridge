# The lite member's service of a rootless install (install.sh --rootless,
# D-79), as the user's own systemd user unit. The release archive carries it
# as packaging/linux/cbb-rootless.service, in place of the full
# member's (member/packaging/archive.sh). It runs as the user, so every program
# of the user can read its keys; a system install (sudo sh install.sh) keeps
# the service under an account and a sandbox of its own instead.
[Unit]
Description=CBB lite member (rootless)
Documentation=https://github.com/HunterEwok/cbb/blob/main/member/README.md
After=network-online.target

[Service]
Type=simple
Environment=CBB_ROOTLESS=1
# install.sh --rootless --port N writes CBB_PORT here.
EnvironmentFile=-%E/cbb/cbb.env
ExecStart=/usr/local/bin/cbb service
# The control and admin sockets, in $XDG_RUNTIME_DIR/cbb.
RuntimeDirectory=cbb
RuntimeDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=2s
NoNewPrivileges=yes
# Secrets live only in memory; none of it goes to swap.
MemorySwapMax=0

[Install]
WantedBy=default.target
